# ==============================================================================
# MediKiosk - Environment Configuration
# ==============================================================================

# Database
# Default: SQLite zero-config local database
# PostgreSQL format: postgresql://postgres:password@localhost:5432/medikiosk
DATABASE_URL=sqlite:///./medikiosk.db

# Security
JWT_SECRET_KEY=medikiosk-super-secure-production-secret-2026-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Optional: Provide Google Gemini API Key for live cloud generation.
# If omitted, MediKiosk automatically runs offline with high-fidelity deterministic MockAIProvider.
GEMINI_API_KEY=

# OCR Provider Configuration
# Options: mock, vision, tesseract
OCR_PROVIDER=mock

# Speech Provider Configuration
# Options: mock, webspeech, google_speech
SPEECH_PROVIDER=mock

# ABDM & HMIS Sandbox
ABDM_SANDBOX_MODE=true
HMIS_FHIR_EXPORT=true

# Server
HOST=0.0.0.0
PORT=8000
